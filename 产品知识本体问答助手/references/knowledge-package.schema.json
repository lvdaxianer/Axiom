{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/product-knowledge-package.schema.json",
  "title": "Product Knowledge Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "document", "sections", "concepts", "relations"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "hash", "title", "language"],
      "properties": {
        "key": {"type": "string", "pattern": "^[^/\\\\]+\\.md$"},
        "hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "title": {"type": "string", "minLength": 1},
        "language": {"const": "zh-CN"}
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "summary"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/section"}
    },
    "concepts": {
      "type": "array",
      "items": {"$ref": "#/$defs/concept"}
    },
    "relations": {
      "type": "array",
      "items": {"$ref": "#/$defs/relation"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"},
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "headingPath", "summary", "content", "conceptIds", "sourceAnchor"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "headingPath": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "summary": {"type": "string", "minLength": 1},
        "content": {"type": "string", "minLength": 1},
        "conceptIds": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
        "sourceAnchor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["startLine", "endLine"],
          "properties": {
            "startLine": {"type": "integer", "minimum": 1},
            "endLine": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "definition", "canonicalAliases", "queryAliases", "evidenceSectionIds"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1},
        "type": {"enum": ["feature", "action", "entity", "state", "rule", "exception", "role"]},
        "definition": {"type": "string", "minLength": 1},
        "canonicalAliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "queryAliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidenceSectionIds": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "from", "type", "to", "evidence"],
      "properties": {
        "operation": {"enum": ["add", "retain", "retire"]},
        "from": {"$ref": "#/$defs/id"},
        "type": {"enum": ["parent_of", "has_part", "creates", "requires", "governed_by", "exception_of", "overrides", "related_to"]},
        "to": {"$ref": "#/$defs/id"},
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sectionId", "quote"],
          "properties": {
            "sectionId": {"$ref": "#/$defs/id"},
            "quote": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
