{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "service", "networkPolicy", "security", "tls", "heap", "resources", "nodeSelector"],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.-]+(?::[0-9]+)?/[A-Za-z0-9._/-]+$",
          "allOf": [
            {"not": {"pattern": "^docker\\.io/"}},
            {"not": {"pattern": "^index\\.docker\\.io/"}},
            {"not": {"pattern": "^registry-1\\.docker\\.io/"}},
            {"not": {"pattern": "^docker\\.elastic\\.co/"}}
          ]
        },
        "tag": {"type": "string", "const": "7.10.2-arm64-hardened"},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"type": "string", "enum": ["IfNotPresent", "Never"]},
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253,
                "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*$"
              }
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port", "loadBalancerIP", "addressPool", "protocol", "externalTrafficPolicy", "loadBalancerSourceRanges", "allowSharedIP", "sharedIPKey", "annotations"],
      "properties": {
        "type": {"type": "string", "const": "LoadBalancer"},
        "port": {"type": "integer", "const": 9200},
        "loadBalancerIP": {
          "type": "string",
          "minLength": 7,
          "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
        },
        "addressPool": {"type": "string", "const": "first-pool"},
        "protocol": {"type": "string", "const": "layer2"},
        "externalTrafficPolicy": {"type": "string", "const": "Local"},
        "loadBalancerSourceRanges": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/([0-9]|[12][0-9]|3[0-2])$"
          }
        },
        "allowSharedIP": {"type": "boolean"},
        "sharedIPKey": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$",
          "not": {"const": "true"}
        },
        "annotations": {
          "type": "object",
          "propertyNames": {
            "allOf": [
              {
                "maxLength": 317,
                "pattern": "^([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*/)?[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$"
              },
              {
                "not": {
                  "enum": [
                    "metallb.universe.tf/address-pool",
                    "metallb.universe.tf/loadBalancerIPs",
                    "metallb.universe.tf/protocol",
                    "metallb.universe.tf/allow-shared-ip",
                    "metallb.io/address-pool",
                    "metallb.io/loadBalancerIPs",
                    "metallb.io/protocol",
                    "metallb.io/allow-shared-ip"
                  ]
                }
              }
            ]
          },
          "additionalProperties": {"type": "string"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"allowSharedIP": {"const": true}}},
          "then": {"properties": {"sharedIPKey": {"minLength": 1}}}
        }
      ]
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dns", "authorizedPeers"],
      "properties": {
        "dns": {
          "type": "object",
          "additionalProperties": false,
          "required": ["namespaceSelector", "podSelector"],
          "properties": {
            "namespaceSelector": {"$ref": "#/$defs/labelSelector"},
            "podSelector": {"$ref": "#/$defs/labelSelector"}
          }
        },
        "authorizedPeers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["namespaceSelector", "podSelector"],
            "properties": {
              "namespaceSelector": {"$ref": "#/$defs/labelSelector"},
              "podSelector": {"$ref": "#/$defs/labelSelector"}
            }
          }
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "server": {
          "type": "string",
          "oneOf": [{"const": ""}, {"minLength": 1}]
        },
        "path": {
          "type": "string",
          "oneOf": [{"const": ""}, {"pattern": "^/[^\\s]*$"}]
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingCredentialsSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
        }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
        }
      }
    },
    "heap": {"type": "string", "pattern": "^-Xms[1-9][0-9]*[mMgG] -Xmx[1-9][0-9]*[mMgG]$"},
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu", "memory"],
          "properties": {
            "cpu": {"type": "string"},
            "memory": {"type": "string"}
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu", "memory"],
          "properties": {
            "cpu": {"type": "string"},
            "memory": {"type": "string"}
          }
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "required": ["kubernetes.io/arch"],
      "properties": {
        "kubernetes.io/arch": {"type": "string", "const": "arm64"}
      }
    }
  },
  "$defs": {
    "labelSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matchLabels"],
      "properties": {
        "matchLabels": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "maxLength": 253,
            "pattern": "^([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*/)?[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$"
          }
        }
      }
    }
  }
}
