{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "security", "tls", "heap", "resources", "nodeSelector"],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.-]+(?::[0-9]+)?/[A-Za-z0-9._/-]+$",
          "allOf": [
            {"not": {"pattern": "^docker\\.io/"}},
            {"not": {"pattern": "^index\\.docker\\.io/"}},
            {"not": {"pattern": "^registry-1\\.docker\\.io/"}},
            {"not": {"pattern": "^docker\\.elastic\\.co/"}}
          ]
        },
        "tag": {"type": "string", "const": "7.10.2-arm64-hardened"},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"type": "string", "enum": ["IfNotPresent", "Never"]},
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253,
                "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*$"
              }
            }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "loadBalancerIP": {
          "type": "string",
          "oneOf": [
            {"const": ""},
            {"pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"}
          ]
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "server": {
          "type": "string",
          "oneOf": [{"const": ""}, {"minLength": 1}]
        },
        "path": {
          "type": "string",
          "oneOf": [{"const": ""}, {"pattern": "^/[^\\s]*$"}]
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingCredentialsSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
        }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
        }
      }
    },
    "heap": {"type": "string", "pattern": "^-Xms[1-9][0-9]*[mMgG] -Xmx[1-9][0-9]*[mMgG]$"},
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu", "memory"],
          "properties": {
            "cpu": {"type": "string"},
            "memory": {"type": "string"}
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu", "memory"],
          "properties": {
            "cpu": {"type": "string"},
            "memory": {"type": "string"}
          }
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "required": ["kubernetes.io/arch"],
      "properties": {
        "kubernetes.io/arch": {"type": "string", "const": "arm64"}
      }
    }
  }
}
